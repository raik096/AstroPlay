---
// src/components/Header.astro
---

<header class="rt-header" id="banner">
    <div class="rt-navbar navbar navbar-classic navbar-top py-3">
        <div class="rt-container rt-header__top-area rt-header__bar">
            
            <div class="align-items-center autofit-row">
                <a class="rt-header__logo-regione" href="https://www.regione.toscana.it/" title="Vai al Portale di Regione Toscana">
                    <img alt="Logo Regione Toscana" class="rt-image-scroll" src="https://open.toscana.it/o/open-toscana-restyled-theme/images/logo-regione-mobile.png" srcset="https://open.toscana.it/o/open-toscana-restyled-theme/images/logo-regione-mobile@2x.png 2x" />
                </a>
                <a class="rt-header__logo-toscana-digitale" href="https://digitale.toscana.it/" title="Vai a Toscana Digitale">
                    <img alt="Logo Toscana Digitale" class="rt-image-scroll secondary" src="https://open.toscana.it/o/open-toscana-restyled-theme/images/toscana-digitale-logo.png" />
                </a>
            </div>
            
            <a accesskey="H" class="rt-header__site-logo" href="/" title="Vai alla homepage di Open Toscana">
                <img alt="Open Toscana" src="https://open.toscana.it/o/open-toscana-restyled-theme/images/open-toscana-logo@2x.png" srcset="https://open.toscana.it/o/open-toscana-restyled-theme/images/open-toscana-logo@2x.png 2x" />
            </a>
            
            <div class="autofit-col rt-header__social align-items-center">
                <div class="rt-social-media social-media-wrapper">
                    <h2 class="rt-social-media__title">seguici su</h2>
                    <ul class="rt-social-media__list">
                        <li id="facebook" class="rt-social-media__item">
                            <a title="Vai alla pagina Facebook" href="http://www.facebook.com/opentoscana" rel="noopener noreferrer" target="_blank" aria-label="link new tab" class="rt-social-media-icon rt-social-media-icon__facebook">
                                <i aria-hidden="true" class="fab fa-facebook-f"></i><span class="hide">Facebook</span>
                            </a>
                        </li>
                        <li id="twitter" class="rt-social-media__item">
                            <a title="Vai al profilo Twitter" href="http://twitter.com/opentoscana" rel="noopener noreferrer" target="_blank" aria-label="link new tab" class="rt-social-media-icon rt-social-media-icon__twitter">
                                <i aria-hidden="true" class="fab fa-twitter"></i><span class="hide">Twitter</span>
                            </a>
                        </li>
                        <li id="linkedin" class="rt-social-media__item">
                            <a title="Vai alla pagina Linkedin" href="http://www.linkedin.com/in/opentoscana" rel="noopener noreferrer" aria-label="link new tab" target="_blank" class="rt-social-media-icon rt-social-media-icon__linkedin">
                                <i aria-hidden="true" class="fab fa-linkedin-in"></i><span class="hide">Linkedin</span>
                            </a>
                        </li>
                    </ul>
                </div>
                </div>

        </div>
    </div>

    <div class="rt-responsive-header">
        <a title="Vai al Portale di Regione Toscana" class="rt-logo-regione-mobile" href="https://www.regione.toscana.it/">
            <img alt="Logo Regione Toscana" class="mr-2" height="56" src="https://open.toscana.it/o/open-toscana-restyled-theme/images/logo-regione-mobile.png" srcset="https://open.toscana.it/o/open-toscana-restyled-theme/images/logo-regione-mobile@2x.png 2x" />
        </a>
        <a class="logo custom-logo align-items-center d-inline-flex d-md-none logo-xs" href="/" rel="nofollow">
            <img alt="logo" class="mr-2 rt-logo-mobile" height="56" src="https://open.toscana.it/o/open-toscana-restyled-theme/images/logo-mobile.png" srcset="https://open.toscana.it/o/open-toscana-restyled-theme/images/logo-mobile@2x.png 2x" />
            <img alt="logo" class="mr-2 rt-logo-mobile-scroll" height="56" src="https://open.toscana.it/o/open-toscana-restyled-theme/images/logo-mobile-scroll.png" srcset="https://open.toscana.it/o/open-toscana-restyled-theme/images/logo-mobile-scroll@2x.png 2x" />
        </a>
    </div>
    </header>