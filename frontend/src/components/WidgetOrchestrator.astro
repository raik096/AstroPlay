---
// src/components/WidgetOrchestrator.astro
const { widgetName } = Astro.props;

let widget = null;
let errorMessage = null;

try {
    const apiUrl = `http://127.0.0.1:3000/api/widgets?where[name][equals]=${encodeURIComponent(widgetName)}&depth=1`;
    console.log("Cerco widget su Payload:", apiUrl); 

    const response = await fetch(apiUrl);
    const data = await response.json();
    
    if (data.docs && data.docs.length > 0) {
        widget = data.docs[0];
        console.log("✅ Widget Trovato! Tag:", widget.tagName);
    } else {
        errorMessage = `⚠️ Widget "${widgetName}" non trovato nel database di Payload.`;
        console.log(errorMessage);
    }
} catch (e) {
    errorMessage = `🚨 Errore di connessione a Payload: ${e.message}`;
    console.error(errorMessage);
}

const jsUrl = widget && widget.jsFile ? `http://127.0.0.1:3000${widget.jsFile.url}` : null;
const cssUrl = widget && widget.cssFile ? `http://127.0.0.1:3000${widget.cssFile.url}` : null;
const Tag = widget ? widget.tagName : null; 
const props = widget && widget.initialProps ? widget.initialProps : {};
---

{!widget && (
    <div style="border: 2px dashed red; padding: 20px; color: red; font-weight: bold; margin: 20px 0;">
        {errorMessage}
    </div>
)}

{widget && (
    <Fragment>
        {!jsUrl && <div style="color: orange;">⚠️ Attenzione: Nessun file JS associato al widget su Payload!</div>}
        
        {cssUrl && <link rel="stylesheet" href={cssUrl} />}
        {jsUrl && <script is:inline src={jsUrl} type="module"></script>}

        <Tag {...props}></Tag>

        <div style="font-size: 10px; color: #ccc; margin-top: 10px;">
            [Area occupata dal custom element: &lt;{Tag}&gt;]
        </div>
    </Fragment>
)}