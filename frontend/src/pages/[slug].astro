---
// src/pages/[slug].astro
import BaseLayout from '../layouts/BaseLayout.astro';

import Hero from '../components/blocks/Hero.astro';
import TextImage from '../components/blocks/TextImage.astro';
import FormBlock from '../components/blocks/FormBlock.astro';
import ServiziSection from '../components/blocks/ServiziSection.astro';
import VideoBlock from '../components/blocks/VideoBlock.astro';
import NewsBlock from '../components/blocks/NewsBlock.astro';
import LogosBlock from '../components/blocks/LogosBlock.astro';

// 2. FORZIAMO LA MODALITÀ SERVER (SSR)
export const prerender = false;

// 3. CATTURIAMO LO SLUG DALL'URL

const { slug } = Astro.params;

// 1. Gestione intelligente dello slug per la Home
// Se lo slug è undefined o vuoto (siamo in radice /), cerchiamo "home"
const targetSlug = slug || 'home'; 
let pageData = null


console.log(`\n🌍 [ASTRO] URL richiesto: /${slug || ''}`);
console.log(`🔄 [ASTRO] Chiedo a Payload lo slug = ${targetSlug}...`);

try {
    // Usiamo targetSlug nella fetch
    const response = await fetch(`http://127.0.0.1:3000/api/pages?where[slug][equals]=${targetSlug}`);
    const data = await response.json();
    
    if (data.docs && data.docs.length > 0) {
        pageData = data.docs[0];
        console.log(`✅ [ASTRO] Successo! Trovata pagina: "${pageData.title}"`);
    }
} catch (e: any) {
    console.error("🚨 [ASTRO] Errore di connessione a Payload:", e.message);
}


// 3. SE NON C'È LA PAGINA, MOSTRA 404
if (!pageData) {
    return Astro.redirect('/404');
}

const blockComponents = {
    'hero-block': Hero,
    textImage: TextImage,
    formBlock: FormBlock,
    serviziSection: ServiziSection,
    videoBlock: VideoBlock, 
    newsBlock: NewsBlock,
    logosBlock: LogosBlock
};
---

<BaseLayout pageTitle={pageData.title}>
    <article class="dynamic-page">
        {pageData.layout && pageData.layout.map((block: any) => {
            const Component = blockComponents[block.blockType as keyof typeof blockComponents];
            
            if (!Component) {
                return (
                    <div class="debug-warning">
                        ⚠️ Blocco "{block.blockType}" non ancora implementato su Astro.
                    </div>
                );
            }

            return <Component {...block} />;
        })}
    </article>
</BaseLayout>
